# Security headers for static hosts that read this file (Cloudflare Pages, Netlify).
#
# NOTE: GitHub Pages ignores this file — it serves it as a plain asset. The live
# policy there comes from the meta tag in src/app/layout.tsx instead. Keep both in
# sync; if the site ever moves to a host that honours _headers, the header form is
# the stronger one because it also covers frame-ancestors.
# A static export cannot set headers itself — on nginx/Apache the equivalent has to
# be configured in the server config instead. Every directive is self-only: no
# third-party origin is permitted at all, which is what makes the privacy claim on
# /transparenz checkable rather than merely stated.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self'; form-action 'none'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
