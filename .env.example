# --- Session security (required in production) ---
# HMAC secret for session cookies + AES key derivation for email encryption.
SESSION_SECRET=change-me-32-chars-minimum

# --- Persistence (optional; without these the local file store in .data/ is used) ---
# Supabase project in eu-central-1 (Frankfurt). Service role key is SERVER-ONLY.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- E-Mail (optional; without a key, mails are logged to the server console) ---
# Brevo (EU data residency, default DPA). Transactional API key.
BREVO_API_KEY=
EMAIL_FROM=hallo@example.com

# --- Analytics (optional; cookieless, no consent banner needed) ---
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# --- Base URL for links in e-mails ---
APP_BASE_URL=http://localhost:3000
